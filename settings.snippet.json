{
  "includeCoAuthoredBy": false,
  "attribution": { "commit": "", "pr": "" },
  "permissions": {
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Bash(dotnet nuget push:*)",
      "Bash(dotnet ef database drop:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(dotnet add package:*)",
      "Bash(dotnet ef database update:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"{{CLAUDE_HOME}}/hooks/commit-guard.ps1\"",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"{{CLAUDE_HOME}}/hooks/dotnet-guard.ps1\"",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
