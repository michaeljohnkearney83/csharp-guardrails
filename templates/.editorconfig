# Drop this in the root of a C# repo. `dotnet format` and the IDE enforce it,
# and the Stop hook fails the turn when changed files break these rules.
root = true

[*]
indent_style = space
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8

[*.{csproj,props,targets,xml,json,yml,yaml}]
indent_size = 2

[*.cs]
indent_size = 4

# ---- Layout -------------------------------------------------------------
csharp_style_namespace_declarations = file_scoped:warning
csharp_prefer_braces = true:warning
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true
csharp_new_line_before_open_brace = all

# ---- Language preferences ----------------------------------------------
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_elsewhere = false:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_prefer_simple_using_statement = true:suggestion
csharp_style_prefer_pattern_matching = true:suggestion
dotnet_style_readonly_field = true:warning
dotnet_style_prefer_conditional_expression_over_return = true:silent
dotnet_style_require_accessibility_modifiers = always:warning
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning

# ---- Naming -------------------------------------------------------------
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_style.prefix_i.required_prefix = I
dotnet_naming_style.prefix_i.capitalization = pascal_case
dotnet_naming_rule.interfaces_start_with_i.symbols = interfaces
dotnet_naming_rule.interfaces_start_with_i.style = prefix_i
dotnet_naming_rule.interfaces_start_with_i.severity = warning

dotnet_naming_symbols.types_and_members.applicable_kinds = class, struct, enum, delegate, method, property, event
dotnet_naming_style.pascal.capitalization = pascal_case
dotnet_naming_rule.types_pascal.symbols = types_and_members
dotnet_naming_rule.types_pascal.style = pascal
dotnet_naming_rule.types_pascal.severity = warning

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private, private_protected
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_rule.private_fields_underscore.severity = warning

dotnet_naming_symbols.constants.applicable_kinds = field, local
dotnet_naming_symbols.constants.required_modifiers = const
dotnet_naming_rule.constants_pascal.symbols = constants
dotnet_naming_rule.constants_pascal.style = pascal
dotnet_naming_rule.constants_pascal.severity = warning

dotnet_naming_symbols.async_methods.applicable_kinds = method
dotnet_naming_symbols.async_methods.required_modifiers = async
dotnet_naming_style.async_suffix.required_suffix = Async
dotnet_naming_style.async_suffix.capitalization = pascal_case
dotnet_naming_rule.async_methods_suffix.symbols = async_methods
dotnet_naming_rule.async_methods_suffix.style = async_suffix
dotnet_naming_rule.async_methods_suffix.severity = suggestion

dotnet_naming_symbols.params_locals.applicable_kinds = parameter, local
dotnet_naming_style.camel.capitalization = camel_case
dotnet_naming_rule.params_camel.symbols = params_locals
dotnet_naming_rule.params_camel.style = camel
dotnet_naming_rule.params_camel.severity = warning

# ---- Analyzer rules (bugs & tech debt) ---------------------------------
dotnet_diagnostic.CA1062.severity = suggestion   # Validate public args
dotnet_diagnostic.CA2007.severity = none         # ConfigureAwait: enable in libraries
dotnet_diagnostic.CA2016.severity = warning      # Forward CancellationToken
dotnet_diagnostic.CA1849.severity = warning      # Sync call in async method
dotnet_diagnostic.CA2000.severity = warning      # Dispose before losing scope
dotnet_diagnostic.CA2200.severity = error        # throw ex; loses stack trace
dotnet_diagnostic.CA2254.severity = warning      # Log templates must be constant
dotnet_diagnostic.CA1848.severity = suggestion   # Use LoggerMessage delegates
dotnet_diagnostic.CA2100.severity = error        # SQL injection risk
dotnet_diagnostic.CA5359.severity = error        # Disabled cert validation
dotnet_diagnostic.CS1998.severity = warning      # async without await
dotnet_diagnostic.CS4014.severity = error        # Un-awaited task
dotnet_diagnostic.IDE0005.severity = warning     # Unused usings
dotnet_diagnostic.IDE0051.severity = warning     # Unused private member
dotnet_diagnostic.IDE0060.severity = warning     # Unused parameter

# Tests may use underscores in method names (Method_State_Expected).
[**/*Tests/**.cs]
dotnet_diagnostic.CA1707.severity = none
